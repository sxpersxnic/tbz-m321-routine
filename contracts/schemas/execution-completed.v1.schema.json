{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routine.example/contracts/schemas/execution-completed.v1.schema.json",
  "title": "ExecutionCompleted v1",
  "description": "An execution finished successfully (original format). Routing key: execution.completed",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "ExecutionCompleted"
    },
    "version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "required": [
        "executionId",
        "routineId",
        "ownerId",
        "routineName",
        "message"
      ],
      "properties": {
        "executionId": {
          "type": "string",
          "format": "uuid"
        },
        "routineId": {
          "type": "string",
          "format": "uuid"
        },
        "ownerId": {
          "type": "string",
          "format": "uuid"
        },
        "routineName": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
