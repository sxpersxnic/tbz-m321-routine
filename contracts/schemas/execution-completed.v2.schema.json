{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routine.example/contracts/schemas/execution-completed.v2.schema.json",
  "title": "ExecutionCompleted v2",
  "description": "An execution finished successfully (structured notification). During the expand phase producers additionally send the v1 field `message`; additionalProperties therefore stays open. Routing key: execution.completed",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "ExecutionCompleted"
    },
    "version": {
      "const": 2
    },
    "data": {
      "type": "object",
      "required": [
        "executionId",
        "routineId",
        "ownerId",
        "routineName",
        "notification",
        "priority"
      ],
      "properties": {
        "executionId": {
          "type": "string",
          "format": "uuid"
        },
        "routineId": {
          "type": "string",
          "format": "uuid"
        },
        "ownerId": {
          "type": "string",
          "format": "uuid"
        },
        "routineName": {
          "type": "string"
        },
        "notification": {
          "type": "object",
          "required": [
            "title",
            "body"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "body": {
              "type": "string"
            }
          }
        },
        "priority": {
          "enum": [
            "low",
            "normal",
            "high"
          ]
        },
        "message": {
          "type": "string",
          "deprecated": true,
          "description": "v1 field, only present during the expand phase."
        }
      },
      "additionalProperties": true
    }
  }
}
