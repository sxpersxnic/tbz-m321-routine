{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routine.example/contracts/schemas/routine-triggered.v1.schema.json",
  "title": "RoutineTriggered v1",
  "description": "A routine was started manually, by its schedule, by a webhook call or by another routine's routine.run step. Routing key: routine.triggered. The only consumer is the routine service itself, so adding the webhook and routine values stayed within v1.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "RoutineTriggered"
    },
    "version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "required": [
        "executionId",
        "routineId",
        "ownerId",
        "trigger"
      ],
      "properties": {
        "executionId": {
          "type": "string",
          "format": "uuid"
        },
        "routineId": {
          "type": "string",
          "format": "uuid"
        },
        "ownerId": {
          "type": "string",
          "format": "uuid"
        },
        "trigger": {
          "enum": [
            "manual",
            "schedule",
            "webhook",
            "routine"
          ]
        },
        "scheduledFor": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": true
    }
  }
}
