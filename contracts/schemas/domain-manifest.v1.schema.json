{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routine.example/contracts/schemas/domain-manifest.v1.schema.json",
  "title": "DomainManifest v1",
  "description": "What a domain offers: triggers, actions, values, collections, quick entry, Today cards and templates (docs/v2/04-domain-platform.md §2). Carried by DomainRegistered on platform.registry. Canonical types: libs/service-kit/src/manifest.ts.",
  "type": "object",
  "required": [
    "contract",
    "domain",
    "manifestVersion",
    "service",
    "name",
    "description",
    "icon",
    "tint",
    "order",
    "optional",
    "prefixes",
    "capabilities"
  ],
  "properties": {
    "contract": {
      "const": 1
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$"
    },
    "manifestVersion": {
      "type": "integer",
      "minimum": 1
    },
    "service": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "type": "string",
      "minLength": 1
    },
    "tint": {
      "$ref": "#/$defs/tint"
    },
    "order": {
      "type": "integer"
    },
    "optional": {
      "type": "boolean"
    },
    "prefixes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*$"
      }
    },
    "page": {
      "type": "string",
      "pattern": "^/"
    },
    "collections": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-zA-Z0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/collection"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trigger"
      }
    },
    "quickEntry": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quickEntry"
      }
    },
    "todayCards": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "item",
          "checklist",
          "metric",
          "event",
          "question",
          "checkIn",
          "attention",
          "suggestion"
        ]
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/template"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "tint": {
      "enum": [
        "sky",
        "indigo",
        "violet",
        "pink",
        "orange",
        "green",
        "teal",
        "grey"
      ]
    },
    "capabilityType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-zA-Z0-9]*$"
    },
    "paramType": {
      "enum": [
        "text",
        "longText",
        "number",
        "integer",
        "money",
        "boolean",
        "date",
        "time",
        "duration",
        "choice",
        "ref",
        "list",
        "object",
        "value"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "deprecated": {
      "type": "object",
      "required": [
        "since",
        "message"
      ],
      "properties": {
        "since": {
          "$ref": "#/$defs/version"
        },
        "replacedBy": {
          "$ref": "#/$defs/capabilityType"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "option": {
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ref": {
      "type": "object",
      "required": [
        "domain",
        "collection"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*$"
        },
        "collection": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        }
      }
    },
    "param": {
      "type": "object",
      "required": [
        "name",
        "label",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/paramType"
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "placeholder": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "templating": {
          "type": "boolean"
        },
        "advanced": {
          "type": "boolean"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "name",
        "label",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/paramType"
        },
        "example": {}
      }
    },
    "capability": {
      "type": "object",
      "required": [
        "type",
        "kind",
        "label",
        "sentence",
        "description",
        "params",
        "output",
        "sideEffects",
        "since"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/capabilityType"
        },
        "kind": {
          "enum": [
            "action",
            "value",
            "human"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "sentence": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "tint": {
          "$ref": "#/$defs/tint"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/param"
          }
        },
        "output": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output"
          }
        },
        "sideEffects": {
          "type": "boolean"
        },
        "preview": {
          "type": "boolean"
        },
        "human": {
          "type": "object",
          "required": [
            "awaits"
          ],
          "properties": {
            "awaits": {
              "enum": [
                "task",
                "question",
                "checkIn"
              ]
            },
            "defaultTimeout": {
              "type": "string",
              "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$"
            }
          }
        },
        "acceptsSecrets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*$"
          }
        },
        "since": {
          "$ref": "#/$defs/version"
        },
        "deprecated": {
          "$ref": "#/$defs/deprecated"
        }
      },
      "allOf": [
        {
          "description": "values read data and never have side effects",
          "if": {
            "properties": {
              "kind": {
                "const": "value"
              }
            }
          },
          "then": {
            "properties": {
              "sideEffects": {
                "const": false
              }
            }
          }
        },
        {
          "description": "actions and human steps change data",
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "action",
                  "human"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "sideEffects": {
                "const": true
              }
            }
          }
        },
        {
          "description": "human steps say what they wait for",
          "if": {
            "properties": {
              "kind": {
                "const": "human"
              }
            }
          },
          "then": {
            "required": [
              "human"
            ]
          }
        }
      ]
    },
    "trigger": {
      "type": "object",
      "required": [
        "type",
        "label",
        "sentence",
        "description",
        "fields",
        "since"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/capabilityType"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "sentence": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output"
          }
        },
        "since": {
          "$ref": "#/$defs/version"
        },
        "deprecated": {
          "$ref": "#/$defs/deprecated"
        }
      }
    },
    "collection": {
      "type": "object",
      "required": [
        "label",
        "list",
        "idField",
        "labelField"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "list": {
          "type": "string",
          "pattern": "^/api/"
        },
        "idField": {
          "type": "string",
          "minLength": 1
        },
        "labelField": {
          "type": "string",
          "minLength": 1
        },
        "iconField": {
          "type": "string",
          "minLength": 1
        },
        "tintField": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "quickEntry": {
      "type": "object",
      "required": [
        "id",
        "pattern",
        "endpoint",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "pattern": {
          "type": "string",
          "pattern": "^\\^"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^/api/"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "template": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "icon",
        "tint",
        "requires",
        "setup",
        "routine"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/capabilityType"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "tint": {
          "$ref": "#/$defs/tint"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*$"
          }
        },
        "setup": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "name",
              "label",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "$ref": "#/$defs/paramType"
              },
              "required": {
                "type": "boolean"
              },
              "default": {},
              "options": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/option"
                }
              },
              "ref": {
                "$ref": "#/$defs/ref"
              }
            }
          }
        },
        "routine": {
          "type": "object"
        }
      }
    }
  }
}
