{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routine.example/contracts/schemas/action-failed.v1.schema.json",
  "title": "ActionFailed v1",
  "description": "An action failed permanently (invalid input or retries exhausted). Routing key: action.failed",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "ActionFailed"
    },
    "version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "required": [
        "actionId",
        "executionId",
        "actionType",
        "error",
        "attempts",
        "processedBy"
      ],
      "properties": {
        "actionId": {
          "type": "string",
          "format": "uuid"
        },
        "executionId": {
          "type": "string",
          "format": "uuid"
        },
        "actionType": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "required": [
            "message"
          ],
          "properties": {
            "code": {
              "description": "Error code of docs/v2/05-messaging.md §6. The last four values are what v1 producers sent (exception class names); consumers map unknown codes to INTERNAL.",
              "enum": [
                "NOT_FOUND",
                "UNAUTHORIZED",
                "FORBIDDEN_HOST",
                "TIMEOUT",
                "UNREACHABLE",
                "RATE_LIMITED",
                "INVALID_PARAMS",
                "TEMPLATE_ERROR",
                "NOT_AVAILABLE",
                "REFERENCE_GONE",
                "SUBROUTINE_FAILED",
                "AWAIT_EXPIRED",
                "QUOTA_EXCEEDED",
                "AI_REFUSED",
                "INPUT_TOO_LARGE",
                "CONFLICT",
                "CANCELLED",
                "INTERNAL",
                "PermanentError",
                "TransientError",
                "Error",
                "SubRoutineFailed"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "processedBy": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
