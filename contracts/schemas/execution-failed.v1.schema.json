{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routine.example/contracts/schemas/execution-failed.v1.schema.json",
  "title": "ExecutionFailed v1",
  "description": "An execution failed. Routing key: execution.failed",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "ExecutionFailed"
    },
    "version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "required": [
        "executionId",
        "routineId",
        "ownerId",
        "routineName",
        "reason"
      ],
      "properties": {
        "executionId": {
          "type": "string",
          "format": "uuid"
        },
        "routineId": {
          "type": "string",
          "format": "uuid"
        },
        "ownerId": {
          "type": "string",
          "format": "uuid"
        },
        "routineName": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "failedActionKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ],
          "description": "error.code of the failed action (docs/v2/05-messaging.md §6), null when no action failed"
        },
        "failedActionType": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
