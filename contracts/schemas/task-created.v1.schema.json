{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routine.example/contracts/schemas/task-created.v1.schema.json",
  "title": "TaskCreated v1",
  "description": "A task was created – in the app, or by a routine step (then with origin). Routing key: task.created on domain.events (docs/v2/services/task-service.md §4).",
  "allOf": [
    {
      "$ref": "domain-event.v1.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "TaskCreated"
    },
    "data": {
      "type": "object",
      "required": [
        "taskId",
        "title",
        "listId",
        "listName",
        "areaId",
        "priority",
        "dueDate",
        "kind",
        "sourceRoutineId"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "listId": {
          "type": "string",
          "format": "uuid"
        },
        "listName": {
          "type": [
            "string",
            "null"
          ]
        },
        "areaId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "priority": {
          "enum": [
            "low",
            "normal",
            "high"
          ]
        },
        "dueDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "kind": {
          "enum": [
            "task",
            "step"
          ]
        },
        "sourceRoutineId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    }
  }
}
