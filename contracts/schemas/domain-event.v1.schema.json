{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routine.example/contracts/schemas/domain-event.v1.schema.json",
  "title": "Domain event v1",
  "description": "Any event on the domain.events exchange (docs/v2/05-messaging.md §4.4). Routing key = the trigger type (task.completed), envelope type = its PascalCase (TaskCompleted). The data's other fields are the trigger's fields from the domain's manifest; consumers ignore extras. Every event type extends this schema.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "required": [
        "ownerId",
        "occurredAt"
      ],
      "properties": {
        "ownerId": {
          "type": "string",
          "format": "uuid"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "areaId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "origin": {
          "type": "object",
          "description": "when a routine step caused the change – loop protection (docs/v2/04-domain-platform.md §3.5)",
          "required": [
            "routineId",
            "depth"
          ],
          "properties": {
            "executionId": {
              "type": "string",
              "format": "uuid"
            },
            "routineId": {
              "type": "string",
              "format": "uuid"
            },
            "actionId": {
              "type": "string",
              "format": "uuid"
            },
            "depth": {
              "type": "integer",
              "minimum": 1,
              "description": "the causing step's context.depth + 1"
            }
          }
        }
      },
      "additionalProperties": true
    }
  }
}
