{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routine.example/contracts/schemas/action-completed.v1.schema.json",
  "title": "ActionCompleted v1",
  "description": "An action was executed successfully. Routing key: action.completed",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "ActionCompleted"
    },
    "version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "required": [
        "actionId",
        "executionId",
        "actionType",
        "output",
        "processedBy",
        "completedAt"
      ],
      "properties": {
        "actionId": {
          "type": "string",
          "format": "uuid"
        },
        "executionId": {
          "type": "string",
          "format": "uuid"
        },
        "actionType": {
          "type": "string"
        },
        "output": {
          "type": "object"
        },
        "processedBy": {
          "type": "string"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "duplicate": {
          "type": "boolean",
          "description": "true if the action had already been processed before (idempotent replay)."
        }
      },
      "additionalProperties": true
    }
  }
}
