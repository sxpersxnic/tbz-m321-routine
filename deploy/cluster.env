# The three VMs of the Kubernetes deployment – deploy/deploy.sh runs on VM1 and reaches the others over SSH.
VM1=10.2.44.21 # k3s server (starts the cluster) · rabbitmq-1 · builds the images
VM2=10.2.44.20 # k3s server · rabbitmq-2
VM3=10.2.44.17 # k3s server · rabbitmq-3 · the five databases
SSH_USER=routine # login on VM2 and VM3: created by deploy/prepare-vm.sh (the line of `deploy.sh key`)
K3S_VERSION=v1.36.5+k3s1 # the version tested with deploy.sh (docs/deployment.md §8) – every VM gets it

# Optional overrides
# PUBLIC_URL=http://routine.example.org:8080  # when a load balancer / DNS name sits in front (default: http://$VM1:8080)
