# The four VMs of the Kubernetes deployment – deploy/deploy.sh runs on VM1 and reaches the others over SSH.
VM1=10.2.44.17 # k3s server (starts the cluster) · rabbitmq-1 · builds the images
VM2=10.2.44.20 # k3s server · rabbitmq-2
VM3=10.2.44.21 # k3s server · rabbitmq-3
VM4=10.2.44.28 # k3s agent · the five databases

# Optional overrides
# SSH_USER=ubuntu                             # login on VM2–VM4 (default: the user running deploy.sh)
# PUBLIC_URL=http://routine.example.org:8080  # when a load balancer / DNS name sits in front (default: http://$VM1:8080)
# K3S_VERSION=v1.34.1+k3s1                    # default: the version on VM1, or the current stable release
