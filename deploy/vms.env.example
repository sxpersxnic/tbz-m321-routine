# Inventory for deploy/deploy.sh – copy to deploy/vms.env and fill in your three VMs.
# Each VM: Linux (e.g. Ubuntu 24.04), 2 vCPU / 4 GB RAM, SSH login with a key, sudo without password.

VM1=ubuntu@10.0.0.11   # databases, rabbitmq-1, replicas
VM2=ubuntu@10.0.0.12   # rabbitmq-2, replicas
VM3=ubuntu@10.0.0.13   # rabbitmq-3, replicas

# Optional overrides
# VM1_ADDR=10.0.0.11              # address the VMs reach each other at (default: host part of VM1)
# VM1_DOCKER=ssh://ubuntu@vm1     # how deploy.sh talks to Docker on VM1 (default: ssh://$VM1)
# PUBLIC_URL=http://routine.example.org:8080   # when the VMs sit behind a load balancer / NAT
# RABBIT_URL=http://10.0.0.11:15672            # management API used by `verify`
# SERVICE_REPLICAS=2 INTEGRATION_WORKER_REPLICAS=3
