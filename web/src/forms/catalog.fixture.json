    "page": "/routines",
    "collections": {
      "routines": {
        "label": "Routines",
        "list": "/api/v1/routines",
        "idField": "id",
        "labelField": "name"
      }
    },
    "capabilities": [
      {
        "type": "routine.run",
        "kind": "action",
        "label": "Run routine",
        "sentence": "Run routine {routineId} with {input}",
        "description": "Runs another routine like a function and waits for it.",
        "params": [
          {
            "name": "routineId",
            "label": "Routine",
            "type": "ref",
            "required": true,
            "ref": {
              "domain": "routines",
              "collection": "routines"
            },
            "templating": false
          },
          {
            "name": "input",
            "label": "Input",
            "type": "value",
            "hint": "The routine reads it as {{input}}; it returns its variable \"result\""
          },
          {
            "name": "routineName",
            "label": "Routine name",
            "type": "text",
            "advanced": true,
            "templating": false
          }
        ],
        "output": [
          {
            "name": "result",
            "label": "Result",
            "type": "value"
          },
          {
            "name": "executionId",
