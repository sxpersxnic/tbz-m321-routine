{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"],
  // unit tests of pure modules run with node --test (root `npm test`) and are typechecked with tsconfig.test.json
  "exclude": ["src/**/*.test.ts"]
}
